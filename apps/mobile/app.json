{
  "expo": {
    "name": "Compasso",
    "slug": "compasso",
    "scheme": "compasso",
    "version": "0.4.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://compasso.homelab-server.space/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dioguit0s.compasso",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "processing"]
      }
    },
    "android": {
      "package": "com.dioguit0s.compasso",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#E7D8BB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "lembretes"
        }
      ],
      "expo-background-task",
      "./plugins/apk-release.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Compasso usa a foto escolhida como imagem de perfil.",
          "cameraPermission": false
        }
      ],
      "expo-splash-screen",
      "expo-font",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/cinzel/600SemiBold/Cinzel_600SemiBold.ttf",
            "../../node_modules/@expo-google-fonts/cinzel/700Bold/Cinzel_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/archivo/400Regular_Italic/Archivo_400Regular_Italic.ttf",
            "../../node_modules/@expo-google-fonts/archivo/500Medium/Archivo_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/archivo/600SemiBold/Archivo_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "SemanaCompasso",
              "label": "Semana",
              "description": "A semana corrente do Compasso: eventos, tarefas e aulas.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-semana.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
