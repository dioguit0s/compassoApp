{
  "expo": {
    "name": "Compasso",
    "slug": "compasso",
    "scheme": "compasso",
    "version": "0.3.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://compasso.homelab-server.space/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dioguit0s.compasso",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "processing"]
      }
    },
    "android": {
      "package": "com.dioguit0s.compasso",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E7D8BB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "lembretes"
        }
      ],
      "expo-background-task",
      "./plugins/apk-release.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Compasso usa a foto escolhida como imagem de perfil.",
          "cameraPermission": false
        }
      ],
      "expo-splash-screen",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
