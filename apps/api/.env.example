# Copie para .env e ajuste. Nunca commite o .env.

# Papel da API (compasso_app): sujeito ao RLS. Obrigatória.
DATABASE_URL=postgres://compasso_app:dev-app@localhost:5432/compasso
# Papel dono (compasso_owner): migrações, criação de conta, purga de tombstones.
# Só scripts leem esta variável; a API em execução nunca.
DATABASE_ADMIN_URL=postgres://compasso_owner:dev-dono@localhost:5432/compasso

PORT=3000
TZ_DEFAULT=America/Sao_Paulo
TRASH_RETENTION_DAYS=30
# Janela de segurança do cursor de sync, em segundos (especificação §6.6 e §10).
SYNC_CURSOR_WINDOW_SECONDS=60

# Entram em fases posteriores (F8):
# AVATAR_DIR=/var/lib/compasso/avatares
# AVATAR_MAX_BYTES=5242880

# Backup (scripts/backup.sh):
# BACKUP_DIR=/var/backups/compasso
# BACKUP_KEEP_DAILY=7
