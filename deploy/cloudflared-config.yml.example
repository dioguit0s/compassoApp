# ~/.cloudflared/config.yml — named tunnel apontando só para a API.
# A porta do PostgreSQL NUNCA entra aqui.
tunnel: compasso
credentials-file: /home/compasso/.cloudflared/<UUID-DO-TUNEL>.json

ingress:
  - hostname: compasso.<seu-dominio>
    service: http://localhost:3000
  - service: http_status:404
